<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: SOLO CAs del sistema. Sin tráfico en claro. Confiar en CAs del
         usuario habilitaría MITM del tráfico HTTPS (token OAuth, API). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Solo en builds debuggable: permite CAs del usuario para poder inspeccionar
         el tráfico con un proxy (Charles/mitmproxy) durante el desarrollo. NO afecta
         al release. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
